{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["src/engine/*"],
      "@rag/*": ["src/rag/*"],
      "@llm/*": ["src/llm/*"],
      "@utils/*": ["src/utils/*"],
      "@cli/*": ["src/cli/*"]
    }
  },
  "include": [
    "src/**/*",
    "rag/**/*",
    "bin/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
