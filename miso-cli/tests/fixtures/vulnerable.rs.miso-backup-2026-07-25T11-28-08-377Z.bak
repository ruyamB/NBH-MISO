use anchor_lang::prelude::*;
use anchor_lang::solana_program::program::invoke;
use anchor_lang::solana_program::system_instruction;

declare_id!("Fg6PaFqRcx9tXqzYbx76WEx215321532153215321532");

#[program]
pub mod vulnerable_bank {
    use super::*;

    pub fn deposit(ctx: Context<Deposit>, amount: u64) -> Result<()> {
        let user_account = &mut ctx.accounts.user_account;
        user_account.balance += amount;
        Ok(())
    }

    // VULNERABLE INSTRUCTION!
    pub fn withdraw(ctx: Context<Withdraw>) -> Result<()> {
        let user_account = &mut ctx.accounts.user_account;
        let amount = user_account.balance;

        require!(amount > 0, BankError::InsufficientFunds);

        // 1. INTERACTION: External transfer via CPI executed BEFORE updating state
        let transfer_instruction = system_instruction::transfer(
            &ctx.accounts.vault.key(),
            &ctx.accounts.user.key(),
            amount,
        );

        invoke(
            &transfer_instruction,
            &[
                ctx.accounts.vault.to_account_info(),
                ctx.accounts.user.to_account_info(),
                ctx.accounts.system_program.to_account_info(),
            ],
        )?;

        // 2. EFFECT: State updated too late!
        user_account.balance = 0;

        Ok(())
    }
}

#[account]
pub struct UserAccount {
    pub balance: u64,
}

#[derive(Accounts)]
pub struct Deposit<'info> {
    #[account(mut)]
    pub user_account: Account<'info, UserAccount>,
    pub user: Signer<'info>,
}

#[derive(Accounts)]
pub struct Withdraw<'info> {
    #[account(mut)]
    pub user_account: Account<'info, UserAccount>,
    /// CHECK: Vault storing program SOL
    #[account(mut)]
    pub vault: AccountInfo<'info>,
    #[account(mut)]
    pub user: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[error_code]
pub enum BankError {
    #[msg("Insufficient funds in account.")]
    InsufficientFunds,
}